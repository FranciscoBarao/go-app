meta {
  name: Create expansion
  type: http
  seq: 2
}

post {
  url: {{catalogBaseUrl}}/api/boardgame/{{boardgameSlug}}/expansion
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  ~Authorization: Bearer {{token}}
}

body:json {
  {
    "name": "Catan: Seafarers",
    "min_players": 3,
    "max_players": 4
  }
}

docs {
  Parent must exist. Expansions cannot have expansions (409).
  Authorization is disabled; enable it or inherit collection Bearer to send {{token}}.
}
