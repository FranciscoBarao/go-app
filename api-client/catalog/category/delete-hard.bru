meta {
  name: Delete hard
  type: http
  seq: 6
}

delete {
  url: {{catalogBaseUrl}}/api/category/{{categorySlug}}
  body: none
  auth: none
}

params:query {
  hard: true
}

headers {
  ~Authorization: Bearer {{token}}
}

docs {
  Permanent delete. Authorization is disabled; enable it or inherit collection Bearer to send {{token}}.
}
