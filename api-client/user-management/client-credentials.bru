meta {
  name: Client credentials
  type: http
  seq: 3
}

post {
  url: {{userManagementBaseUrl}}/api/auth
  body: formUrlEncoded
  auth: none
}

headers {
  Content-Type: application/x-www-form-urlencoded
}

body:form-urlencoded {
  grant_type: client_credentials
  client_id: id
  client_secret: secret
}

script:post-response {
  if (res.body && res.body.access_token) {
    bru.setEnvVar("token", res.body.access_token);
  }
}

docs {
  Client credentials grant (go-chi/oauth ClientCredentials).
  id/secret match the current hardcoded verifier in user-management.
  On success, access_token is stored in this collection's local env as token.
}
