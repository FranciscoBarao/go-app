{
    "swagger": "2.0",
    "info": {
        "description": "This microservice is a marketplace to create, display and buy offers",
        "title": "Marketplace App Swagger",
        "contact": {
            "name": "Francisco Barao",
            "email": "s.franciscobarao@gmail.com"
        },
        "version": "1.0"
    },
    "basePath": "/api/",
    "paths": {
        "/offer": {
            "get": {
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "offer"
                ],
                "summary": "Fetches all Offers",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/model.Offer"
                        }
                    }
                }
            },
            "post": {
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "offer"
                ],
                "summary": "Creates a Offer based on a json body",
                "parameters": [
                    {
                        "description": "The input Offer struct",
                        "name": "data",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/model.Offer"
                        }
                    },
                    {
                        "type": "string",
                        "default": "Bearer \u003cAdd access token here\u003e",
                        "description": "Insert your access token",
                        "name": "Authorization",
                        "in": "header",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/model.Offer"
                        }
                    }
                }
            }
        },
        "/offer/{id}": {
            "get": {
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "offer"
                ],
                "summary": "Fetches a Offer",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/model.Offer"
                        }
                    }
                }
            },
            "delete": {
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "offer"
                ],
                "summary": "Deletes a specific Offer via Uuid",
                "parameters": [
                    {
                        "type": "integer",
                        "description": "The Offer id",
                        "name": "id",
                        "in": "path",
                        "required": true
                    },
                    {
                        "type": "string",
                        "default": "Bearer \u003cAdd access token here\u003e",
                        "description": "Insert your access token",
                        "name": "Authorization",
                        "in": "header",
                        "required": true
                    }
                ],
                "responses": {
                    "204": {
                        "description": ""
                    }
                }
            },
            "patch": {
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "offer"
                ],
                "summary": "Updates a specific Offer via Uuid",
                "parameters": [
                    {
                        "type": "integer",
                        "description": "The Offer id",
                        "name": "id",
                        "in": "path",
                        "required": true
                    },
                    {
                        "description": "The Offer struct to be updated into",
                        "name": "data",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/model.Offer"
                        }
                    },
                    {
                        "type": "string",
                        "default": "Bearer \u003cAdd access token here\u003e",
                        "description": "Insert your access token",
                        "name": "Authorization",
                        "in": "header",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/model.Offer"
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "model.Offer": {
            "type": "object",
            "properties": {
                "name": {
                    "description": "Offer information",
                    "type": "string"
                },
                "price": {
                    "type": "number"
                },
                "type": {
                    "description": "Catalog information",
                    "type": "string"
                },
                "username": {
                    "description": "User information",
                    "type": "string"
                },
                "uuid": {
                    "description": "Automatic",
                    "type": "string"
                }
            }
        }
    }
